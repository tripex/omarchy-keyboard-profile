#!/bin/bash

# Switch the keyboard profile defined in ~/.config/hypr/keyboard-profile.lua.
# Usage: keyboard-profile [status|toggle|mac|windows|bindings <mac|windows>|menu|setup|teardown]

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/tripex-keyboard-profile/active"
HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
CONFIG_FILE="$HYPR_DIR/keyboard-profile.lua"
HYPRLAND_FILE="$HYPR_DIR/hyprland.lua"
LOADED_PATTERN='^[[:space:]]*require\("hypr\.keyboard-profile"\)'
BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

is_set_up() {
  [[ -f $CONFIG_FILE ]] && grep -qE "$LOADED_PATTERN" "$HYPRLAND_FILE" 2>/dev/null
}

# Hyprland only runs the profiles once hyprland.lua loads them. An existing
# keyboard-profile.lua is kept, since it holds the user's own layouts and bindings.
setup() {
  if [[ ! -f $HYPRLAND_FILE ]]; then
    echo "keyboard-profile: $HYPRLAND_FILE is missing" >&2
    omarchy-osd -i keyboard -m "hyprland.lua not found"
    exit 1
  fi

  is_set_up && return

  [[ -f $CONFIG_FILE ]] || cp "$BIN_DIR/../examples/keyboard-profile.lua" "$CONFIG_FILE" || exit 1

  if ! grep -qE "$LOADED_PATTERN" "$HYPRLAND_FILE"; then
    printf '\n-- Keyboard profiles (tripex.keyboard-profile).\nrequire("hypr.keyboard-profile")\n' >>"$HYPRLAND_FILE" || exit 1
  fi

  hyprctl reload >/dev/null
}

# keyboard-profile.lua stays, so a later setup gets the user's own profiles back.
teardown() {
  sed -E -i --follow-symlinks \
    -e '/^-- Keyboard profiles \(tripex\.keyboard-profile\)\.$/d' \
    -e "/$LOADED_PATTERN/d" \
    "$HYPRLAND_FILE" || exit 1

  hyprctl reload >/dev/null
}

# The Hyprland config is only changed after the user has said yes.
ask_setup() {
  is_set_up && return

  local selection
  selection=$(omarchy-menu-select "Set up keyboard profiles" \
    $'󰄬\tSet up\tCreates keyboard-profile.lua and adds one line to hyprland.lua' \
    $'󰅖\tCancel' -- --width 640) || exit 0

  [[ $selection == "Set up"* ]] || exit 0
  setup
}

current() {
  if [[ $(cat "$STATE_FILE" 2>/dev/null) == windows ]]; then
    echo windows
  else
    echo mac
  fi
}

apply() {
  ask_setup
  mkdir -p "$(dirname "$STATE_FILE")" || exit 1
  printf '%s\n' "$1" >"$STATE_FILE" || exit 1

  # The config reads the state file, so a reload swaps layout and bindings together.
  hyprctl reload >/dev/null || exit 1

  if [[ $1 == windows ]]; then
    omarchy-osd -i keyboard -m "Windows keyboard"
  else
    omarchy-osd -i keyboard -m "Mac keyboard"
  fi

  # fcitx5 keeps the keymap it got when its keyboard grab started, so without a
  # restart text fields keep typing with the previous layout until focus moves.
  omarchy-restart-xcompose >/dev/null 2>&1
}

# Everything that works on a keyboard: its own bindings first, then the shared
# ones. The live list only knows the active profile, so all profile bindings are
# taken out of it and the requested profile's are added back.
bindings() {
  if [[ ! -f $CONFIG_FILE ]]; then
    echo "keyboard-profile: $CONFIG_FILE is missing, run: keyboard-profile setup" >&2
    exit 1
  fi

  local rows
  rows=$(lua "$BIN_DIR/profile-bindings.lua") || exit 1

  own_lines() {
    awk -F '\t' -v profile="${1:-}" 'profile == "" || $1 == profile { printf "%-35s → %s\n", $2, $3 }' <<<"$rows"
  }

  own_lines "$1"
  omarchy-menu-keybindings --print | grep -vxFf <(own_lines)
}

show_bindings() {
  local title="$2"
  # Read-only: bindings for the keyboard that isn't active can't be run from here.
  bindings "$1" | omarchy-menu-select "$title" -- --width 800 --height 500 >/dev/null
}

menu() {
  ask_setup

  local mac_row=$'󰀵\tMac keyboard' windows_row=$'󰖳\tWindows keyboard' selection

  if [[ $(current) == windows ]]; then
    windows_row+=$'\tSelected'
  else
    mac_row+=$'\tSelected'
  fi

  selection=$(omarchy-menu-select "Keybindings" "$mac_row" "$windows_row" -- --width 420) || exit 0

  case "$selection" in
  Mac*) show_bindings mac "Keybindings: Mac keyboard" ;;
  Windows*) show_bindings windows "Keybindings: Windows keyboard" ;;
  esac
}

case "${1:-status}" in
status)
  current
  ;;
toggle)
  if [[ $(current) == windows ]]; then
    apply mac
  else
    apply windows
  fi
  ;;
mac | windows)
  apply "$1"
  ;;
bindings)
  [[ ${2:-} == mac || ${2:-} == windows ]] || {
    echo "Usage: keyboard-profile bindings <mac|windows>" >&2
    exit 1
  }
  bindings "$2"
  ;;
menu)
  menu
  ;;
setup)
  setup
  ;;
teardown)
  teardown
  ;;
*)
  echo "Usage: keyboard-profile [status|toggle|mac|windows|bindings <mac|windows>|menu|setup|teardown]" >&2
  exit 1
  ;;
esac
