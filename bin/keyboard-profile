#!/bin/bash

# Switch the keyboard profile defined in ~/.config/hypr/keyboard-profile.lua.
# Usage: keyboard-profile [status|toggle|mac|windows|bindings <mac|windows>|menu]

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/tripex-keyboard-profile/active"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/keyboard-profile.lua"
BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

# The plugin doesn't touch the Hyprland config, so the user has to connect it first.
require_config() {
  [[ -f $CONFIG_FILE ]] && return
  echo "keyboard-profile: $CONFIG_FILE is missing, see the plugin's README" >&2
  omarchy-osd -i keyboard -m "Set up keyboard-profile.lua first (see README)"
  exit 1
}

current() {
  if [[ $(cat "$STATE_FILE" 2>/dev/null) == windows ]]; then
    echo windows
  else
    echo mac
  fi
}

apply() {
  require_config
  mkdir -p "$(dirname "$STATE_FILE")" || exit 1
  printf '%s\n' "$1" >"$STATE_FILE" || exit 1

  # The config reads the state file, so a reload swaps layout and bindings together.
  hyprctl reload >/dev/null || exit 1

  if [[ $1 == windows ]]; then
    omarchy-osd -i keyboard -m "Windows keyboard"
  else
    omarchy-osd -i keyboard -m "Mac keyboard"
  fi

  # fcitx5 keeps the keymap it got when its keyboard grab started, so without a
  # restart text fields keep typing with the previous layout until focus moves.
  omarchy-restart-xcompose >/dev/null 2>&1
}

# Everything that works on a keyboard: its own bindings first, then the shared
# ones. The live list only knows the active profile, so all profile bindings are
# taken out of it and the requested profile's are added back.
bindings() {
  require_config

  local rows
  rows=$(lua "$BIN_DIR/profile-bindings.lua") || exit 1

  own_lines() {
    awk -F '\t' -v profile="${1:-}" 'profile == "" || $1 == profile { printf "%-35s → %s\n", $2, $3 }' <<<"$rows"
  }

  own_lines "$1"
  omarchy-menu-keybindings --print | grep -vxFf <(own_lines)
}

show_bindings() {
  local title="$2"
  # Read-only: bindings for the keyboard that isn't active can't be run from here.
  bindings "$1" | omarchy-menu-select "$title" -- --width 800 --height 500 >/dev/null
}

menu() {
  require_config

  local mac_row=$'󰀵\tMac keyboard' windows_row=$'󰖳\tWindows keyboard' selection

  if [[ $(current) == windows ]]; then
    windows_row+=$'\tSelected'
  else
    mac_row+=$'\tSelected'
  fi

  selection=$(omarchy-menu-select "Keybindings" "$mac_row" "$windows_row" -- --width 420) || exit 0

  case "$selection" in
  Mac*) show_bindings mac "Keybindings: Mac keyboard" ;;
  Windows*) show_bindings windows "Keybindings: Windows keyboard" ;;
  esac
}

case "${1:-status}" in
status)
  current
  ;;
toggle)
  if [[ $(current) == windows ]]; then
    apply mac
  else
    apply windows
  fi
  ;;
mac | windows)
  apply "$1"
  ;;
bindings)
  [[ ${2:-} == mac || ${2:-} == windows ]] || {
    echo "Usage: keyboard-profile bindings <mac|windows>" >&2
    exit 1
  }
  bindings "$2"
  ;;
menu)
  menu
  ;;
*)
  echo "Usage: keyboard-profile [status|toggle|mac|windows|bindings <mac|windows>|menu]" >&2
  exit 1
  ;;
esac
